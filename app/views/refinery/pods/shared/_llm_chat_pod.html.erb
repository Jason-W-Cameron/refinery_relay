<%# Refinery Relay LLM Chat Pod. Interactive behavior is progressively attached by the engine JavaScript. %>
<%
  contract = RefineryRelay::PodContract
  pod_key = pod.respond_to?(:id) && pod.id.present? ? pod.id : pod.object_id
  chat_id = "refinery-relay-chat-#{pod_key}"
  route_helpers = RefineryRelay::Engine.routes.url_helpers
  chat_path = route_helpers.api_relay_chat_path(script_name: "/refinery_relay")
  availability_path = route_helpers.api_relay_chat_availability_path(script_name: "/refinery_relay")
  suggested_questions = contract.suggested_questions(pod)
  theme = RefineryRelay::ChatTheme.current
  pod_settings = RefineryRelay::PodSettings.for(pod)
  source_origin = RefineryRelay.configuration.public_base_url.presence || request.base_url
%>

<section id="<%= chat_id %>"
         class="refinery-relay-chat pod-llm-chat"
         aria-labelledby="<%= chat_id %>-heading"
         data-refinery-relay-chat
         data-chat-url="<%= chat_path %>"
         data-availability-url="<%= availability_path %>"
         data-channel="RefineryRelay::RelayChatChannel"
         data-source-origin="<%= source_origin %>"
         style="<%= theme.css_variables %>">
  <div class="refinery-relay-chat__initial" data-refinery-relay-view="initial">
    <div class="refinery-relay-chat__initial-layout">
      <div class="refinery-relay-chat__initial-content">
        <header class="refinery-relay-chat__header">
          <p class="refinery-relay-chat__eyebrow">Niimble Relay</p>
          <h2 id="<%= chat_id %>-heading" class="refinery-relay-chat__heading">
            <%= contract.heading(pod) %>
          </h2>
        </header>

        <form class="refinery-relay-chat__form refinery-relay-chat__form--initial"
              action="<%= chat_path %>"
              method="post"
              data-refinery-relay-form>
          <% if suggested_questions.any? %>
            <div class="refinery-relay-chat__suggestions">
              <div class="refinery-relay-chat__suggestion-list">
                <% suggested_questions.each do |question| %>
                  <button type="button"
                          class="refinery-relay-chat__suggestion"
                          data-refinery-relay-suggestion>
                    <%= question %>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>

          <label for="<%= chat_id %>-prompt" class="refinery-relay-chat__label">
            Ask a question
          </label>
          <div class="refinery-relay-chat__composer">
            <span class="refinery-relay-chat__prompt-icon" aria-hidden="true">
              <span></span>
            </span>
            <textarea id="<%= chat_id %>-prompt"
                      class="refinery-relay-chat__input"
                      name="message"
                      rows="1"
                      maxlength="4000"
                      autocomplete="off"
                      required
                      placeholder="<%= pod_settings.prompt_placeholder %>"
                      data-refinery-relay-input></textarea>
            <button type="submit"
                    class="refinery-relay-chat__send"
                    aria-label="Send question"
                    data-refinery-relay-send>
              <svg class="refinery-relay-chat__send-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 19V5"></path>
                <path d="m5 12 7-7 7 7"></path>
              </svg>
              <svg class="refinery-relay-chat__loading-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="34 16"></circle>
              </svg>
            </button>
          </div>
        </form>
      </div>

      <div class="refinery-relay-chat__initial-aside">
        <aside class="refinery-relay-chat__information-card">
          <p><%= pod_settings.information_text %></p>
        </aside>

        <footer class="refinery-relay-chat__footer">
          <span>
            Answers are generated from this organisation’s published information using AI.
            <a class="refinery-relay-chat__terms-link"
               href="<%= pod_settings.terms_link %>"
               target="_blank"
               rel="noopener noreferrer">Terms &amp; Conditions</a>
          </span>
          <div class="refinery-relay-chat__attribution">
            <span>Niimble Relay developed by</span>
            <a class="refinery-relay-chat__logo-link"
               href="<%= pod_settings.footer_logo_link %>"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Visit Niimble">
              <%= image_tag pod_settings.footer_logo_url,
                            alt: "Niimble",
                            class: "refinery-relay-chat__footer-logo" %>
            </a>
          </div>
        </footer>
      </div>
    </div>
  </div>

  <div class="refinery-relay-chat__conversation"
       aria-labelledby="<%= chat_id %>-conversation-heading"
       data-refinery-relay-view="conversation"
       hidden>
    <header class="refinery-relay-chat__conversation-header">
      <h2 id="<%= chat_id %>-conversation-heading" class="refinery-relay-chat__conversation-heading">
        <%= contract.heading(pod) %>
      </h2>
      <button type="button"
              class="refinery-relay-chat__reset"
              aria-label="Start a new conversation"
              title="Start a new conversation"
              data-refinery-relay-reset>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 3-6.7"></path>
          <path d="M3 4v5h5"></path>
        </svg>
      </button>
    </header>

    <div class="refinery-relay-chat__workspace">
      <div class="refinery-relay-chat__conversation-column">
        <div class="refinery-relay-chat__messages"
             role="log"
             aria-live="polite"
             aria-relevant="additions"
             data-refinery-relay-messages></div>

        <div class="refinery-relay-chat__typing"
             role="status"
             aria-live="polite"
             aria-label="Niimble Relay is preparing an answer"
             data-refinery-relay-typing
             hidden>
          <span class="refinery-relay-chat__typing-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </div>

        <p class="refinery-relay-chat__error"
           role="alert"
           data-refinery-relay-error
           hidden></p>

        <form class="refinery-relay-chat__form refinery-relay-chat__form--conversation"
              action="<%= chat_path %>"
              method="post"
              data-refinery-relay-form>
          <label for="<%= chat_id %>-conversation-prompt" class="refinery-relay-chat__label">
            Ask another question
          </label>
            <div class="refinery-relay-chat__composer">
              <span class="refinery-relay-chat__prompt-icon" aria-hidden="true">
                <span></span>
              </span>
              <textarea id="<%= chat_id %>-conversation-prompt"
                      class="refinery-relay-chat__input"
                      name="message"
                      rows="1"
                      maxlength="4000"
                      autocomplete="off"
                      required
                      placeholder="Ask another question…"
                      data-refinery-relay-input></textarea>
            <button type="submit"
                    class="refinery-relay-chat__send refinery-relay-chat__send--conversation"
                    aria-label="Send question"
                    data-refinery-relay-send>
              <svg class="refinery-relay-chat__send-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
              <svg class="refinery-relay-chat__loading-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="34 16"></circle>
              </svg>
            </button>
          </div>
        </form>
      </div>

      <div class="refinery-relay-chat__sources-column-wrapper">
        <aside class="refinery-relay-chat__sources-column" aria-labelledby="<%= chat_id %>-sources-heading">
          <div class="refinery-relay-chat__sources-heading-row">
            <h3 id="<%= chat_id %>-sources-heading" class="refinery-relay-chat__sources-heading">Sources</h3>
          </div>
          <p class="refinery-relay-chat__source-count"
             aria-live="polite"
             data-refinery-relay-source-count>
            References appear here
          </p>
          <div class="refinery-relay-chat__sources" data-refinery-relay-sources></div>
          <div class="refinery-relay-chat__empty-sources" data-refinery-relay-empty-sources>
            <span class="refinery-relay-chat__empty-sources-icon" aria-hidden="true">✦</span>
            <p>Supporting pages will appear here with each answer.</p>
          </div>
        </aside>

        <footer class="refinery-relay-chat__conversation-footer">
          <span>
            Answers are generated from this organisation’s published information using AI.
            <a class="refinery-relay-chat__terms-link"
               href="<%= pod_settings.terms_link %>"
               target="_blank"
               rel="noopener noreferrer">Terms &amp; Conditions</a>
          </span>
          <div class="refinery-relay-chat__attribution">
            <span>Niimble Relay developed by</span>
            <a class="refinery-relay-chat__logo-link"
               href="<%= pod_settings.footer_logo_link %>"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Visit Niimble">
              <%= image_tag pod_settings.footer_logo_url,
                            alt: "Niimble",
                            class: "refinery-relay-chat__footer-logo" %>
            </a>
          </div>
        </footer>
      </div>
    </div>
  </div>

  <div class="refinery-relay-chat__unavailable"
       role="status"
       data-refinery-relay-unavailable
       hidden>
    Chat is temporarily unavailable. Please try again later.
  </div>

</section>
